<Window x:Class="Group4333.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Group4333"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Людоговская София 4333" FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Grid.Row="0" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="btnImport" 
                    Content="Импорт данных (Excel)" 
                    Height="40" 
                    FontSize="14"
                    Click="BtnImport_Click"
                    Margin="0,0,0,10"/>

            <Button x:Name="btnExport" 
                    Content="Экспорт в Excel" 
                    Height="40" 
                    FontSize="14"
                    Click="BtnExport_Click"
                    Margin="0,0,0,10"/>

            <Button x:Name="btnImportJson" 
                    Content="Импорт JSON данных" 
                    Height="40" 
                    FontSize="14"
                    Click="BtnImportJson_Click"
                    Margin="0,0,0,10"/>

            <Button x:Name="btnExportWord" 
                    Content="Экспорт в Word" 
                    Height="40" 
                    FontSize="14"
                    Click="BtnExportWord_Click"
                    Margin="0,0,0,10"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="2" Text="Готов к работе" TextWrapping="Wrap" 
                   Foreground="Gray" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>